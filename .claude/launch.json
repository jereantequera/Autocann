{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "autocann-web",
      "runtimeExecutable": "apps/tent/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "autocann.cli.backend"
      ],
      "port": 5000,
      "autoPort": true,
      "env": {
        "AUTOCANN_INDOOR_PRIMARY": "a",
        "AUTOCANN_INDOOR_OBSERVERS": "b",
        "PYTHONPATH": "apps/tent"
      }
    }
  ]
}
